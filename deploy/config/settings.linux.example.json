{
  "_comment": "mail-client Linux/Kylin V10 SP3 x86_64 安装设置示例。复制为 settings.json 后按需修改；install.sh 首次运行会自动生成 settings.json 并写入随机密钥。settings.json 含密钥，权限 600，禁止提交版本库。",

  "serviceName": "mail-client",
  "installDir": "/opt/mail-client",
  "javaHome": "/usr/lib/jvm/java-21-openjdk",
  "runUser": "mail",
  "runGroup": "mail",

  "serverPort": 8080,

  "publicOrigin": "http://mail.example.internal:8080",
  "authCookieSecure": false,
  "allowPrivateHost": false,
  "storageMode": "local",

  "javaOpts": "-Xms512m -Xmx1024m -XX:+UseG1GC",

  "db": {
    "host": "localhost",
    "port": 3306,
    "name": "mail_client",
    "user": "mailclient",
    "password": "CHANGE_ME_DB_PW",
    "mysqlBin": "/usr/bin/mysql"
  },

  "redis": {
    "host": "localhost",
    "port": 6379,
    "password": "CHANGE_ME_REDIS_PW"
  },

  "jwtSecret": "",
  "masterKey": "",

  "firewall": {
    "openPort": true,
    "zone": "public"
  },

  "selinux": {
    "adjust": true
  }
}
